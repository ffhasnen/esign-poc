<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CSP base URL:"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/baseUrlInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="https://example-app-ff--csp-esign-clone-xmfe0dvz.web.app"
        android:inputType="textUri"
        android:text="https://example-app-ff--csp-esign-clone-xmfe0dvz.web.app" />

    <Button
        android:id="@+id/launchCspBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Launch CSP"
        android:textAllCaps="false" />

</LinearLayout>
